{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/test.php",
      "use": "vercel-php@0.8.0"
    },
    {
      "src": "api/index.php",
      "use": "vercel-php@0.8.0"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/test",
      "dest": "/api/test.php"
    },
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "KopiZ",
    "APP_ENV": "production",
    "APP_KEY": "base64:yfYSh6/VQyuwk/CA1KGdo4oeQVG3oZBZgXXLmGrkwZA=",
    "APP_DEBUG": "true",
    "DB_CONNECTION": "pgsql",
    "DATABASE_URL": "postgresql://postgres.zvvacylkdrlebsomarsw:mlr3HSGpgu50wkDQ@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require",
    "DB_HOST": "aws-0-us-east-1.pooler.supabase.com",
    "DB_PORT": "5432",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.zvvacylkdrlebsomarsw",
    "DB_PASSWORD": "mlr3HSGpgu50wkDQ",
    "DB_SSLMODE": "require",
    "SESSION_DRIVER": "cookie",
    "CACHE_STORE": "array",
    "LOG_CHANNEL": "stderr",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views"
  }
}
